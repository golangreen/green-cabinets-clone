// Cloudflare hosting for greencabinetsny.com: the built site (dist) as static
// assets, with every public route pre-rendered to dist/<route>/index.html by
// scripts/prerender.mjs. Unknown paths get dist/404.html with a real 404
// status. worker/index.ts runs first for page requests (not /assets/*) to
// redirect www → apex and legacy URLs with 301s.
{
  "name": "greencabinetsny",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "greencabinetsny.com", "custom_domain": true },
    { "pattern": "www.greencabinetsny.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
