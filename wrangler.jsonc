// Cloudflare hosting for greencabinetsny.com: the built site (dist) as static
// assets, unknown paths fall back to index.html for the React router.
{
  "name": "greencabinetsny",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "routes": [
    { "pattern": "greencabinetsny.com", "custom_domain": true },
    { "pattern": "www.greencabinetsny.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash"
  }
}
