<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Green Cabinets</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Green Cabinets uses the camera to show cabinets in your room in AR, to measure walls and openings, to scan your room in 3D, and to scan drawings you choose to send us.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Green Cabinets saves the pictures you choose to keep, like your AR cabinets or your room plan, to your photo library.</string>
	<key>UIAppFonts</key>
	<array>
		<string>CormorantGaramond-Medium.ttf</string>
		<string>CormorantGaramond-MediumItalic.ttf</string>
		<string>CormorantGaramond-SemiBold.ttf</string>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>text</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Text us</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>message</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>measure</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Measure a wall</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>ruler</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>quote</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Get a quote</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>paperplane</string>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Ink</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
